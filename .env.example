# Example only: never commit real credentials.
APP_ENV=production
BOT_TOKEN=
BOT_USERNAME=
BOT_OWNER_ID=
WEBHOOK_SECRET=
SHORTENER_CALLBACK_SECRET=
WEBHOOK_URL=https://YOUR-KOYEB-DOMAIN/webhook.php
LOG_FILE=/dev/stderr
TELEGRAM_API_BASE=https://api.telegram.org

# External MySQL (Aiven, etc.). Prefer the provider's complete mysql:// service URI.
# Example format only; never put a real URI/password in this file or Git.
DB_URL=
# Alternative when not using DB_URL:
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# DB_URL query ssl-mode=REQUIRED automatically enables TLS.
# You can also explicitly set DB_SSL_MODE=required.
DB_SSL_MODE=
# Recommended: provide the provider CA certificate for server-certificate verification.
# Set either DB_SSL_CA to a readable file path or DB_SSL_CA_PEM to the PEM contents.
DB_SSL_CA=
DB_SSL_CA_PEM=

# Koyeb container runs migrations on startup by default.
AUTO_MIGRATE=true
