# Example only: never commit real credentials.
APP_ENV=production
BOT_TOKEN=
BOT_USERNAME=
BOT_OWNER_ID=
WEBHOOK_SECRET=
# Use a separate random secret of at least 32 characters for signed shortener adapter callbacks.
SHORTENER_CALLBACK_SECRET=
WEBHOOK_URL=https://example.com/webhook.php
LOG_FILE=
TELEGRAM_API_BASE=https://api.telegram.org

# MySQL / MariaDB (Phase 2)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Alternatively, set DB_DSN=mysql:host=localhost;port=3306;dbname=database_name;charset=utf8mb4

# Optional private PHP config file outside public web root:
# BOT_CONFIG_FILE=/home/yourcpaneluser/private/php-bot-config.php
