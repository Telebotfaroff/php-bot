APP_ENV=production
BOT_TOKEN=
BOT_USERNAME=
BOT_OWNER_ID=
WEBHOOK_SECRET=
SHORTENER_CALLBACK_SECRET=
WEBHOOK_URL=https://YOUR-KOYEB-DOMAIN/webhook.php
LOG_FILE=/dev/stderr
TELEGRAM_API_BASE=https://api.telegram.org

# Aiven PostgreSQL service URI; save the real value as a Koyeb Secret.
DB_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DSN=

# PostgreSQL TLS defaults to require. verify-ca requires a CA certificate.
DB_SSL_MODE=
DB_SSL_CA=
DB_SSL_CA_PEM=
AUTO_MIGRATE=true
